# Supply-chain hygiene.

# Block install-time lifecycle scripts (preinstall/postinstall/binding.gyp) —
# the mechanism most recent npm compromises have ridden on.
ignore-scripts=true

# Resolve only versions published before this date, rather than the latest.
# Set 2026-06-15 during an active npm compromise wave, to sit ~a week behind
# the front. Note this pins the whole dependency tree to that date: bump it (or
# drop the line) before relying on anything published since.
before=2026-06-08
