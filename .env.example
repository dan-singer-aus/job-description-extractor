# Copy to .env.local and fill in. Next.js auto-loads .env.local (no dotenv needed).
#
# The web app builds both providers at startup, so `npm run dev` needs both keys.
# The CLI scripts (npm run runner / npm run eval) only import the provider you
# ask for, so they need just that vendor's key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
